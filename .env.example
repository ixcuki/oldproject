# Copy to .env and fill in. The key stays on the server.
# Provider: auto | gemini | openai | local. "local" отключает сеть и всегда использует planner.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=anthropic/claude-haiku-5.5
LLM_BASE_URL=https://routerai.ru/api/v1

# Gemini напрямую (ключ вида AQ.… или AIza…, LLM_PROVIDER=gemini):
# LLM_MODEL=gemini-3.8-flash
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Любой OpenAI-совместимый шлюз:
# LLM_PROVIDER=openai
# LLM_MODEL=<model-id>
# LLM_BASE_URL=https://api.openai.com/v1

# UNIPULSE_DB=data/unipulse.db
# UNIPULSE_SEED=1
